    id("opsManualForm").innerHTML=`<div class="card notice"><strong>現在の正本</strong><p class="small no-bottom">${esc(scene.lead)}</p></div><div class="ops-form-section"><h3>利用シーン</h3><div class="ops-checkbox-grid" id="opsManualSceneTags">${SCENE_TAGS.map((tag)=>`<label class="ops-checkbox-label"><input type="checkbox" value="${esc(tag)}" ${(meta.sceneTags||[]).includes(tag)?'checked':''}>${esc(tag)}</label>`).join("")}</div></div><div class="ops-grid-2"><label>店主確認レベル<select class="form-input" id="opsManualOwnerLevel">${OWNER_LEVELS.map((label,index)=>`<option value="${index}" ${Number(meta.ownerLevel)===index?'selected':''}>レベル${index}｜${esc(label)}</option>`).join("")}</select></label><label>見直し周期<select class="form-input" id="opsManualReviewMonths"><option value="6" ${Number(meta.reviewMonths)===6?'selected':''}>6か月</option><option value="12" ${Number(meta.reviewMonths)!==6?'selected':''}>1年</option></select></label></div><div class="ops-form-section"><label>基準の理由<textarea id="opsManualReason" maxlength="4000" placeholder="接客品質・安全・AMORÉTTOの考え方">${esc(meta.reason)}</textarea></label><label>優先順位（1行1項目・最大5件）<textarea id="opsManualPriority">${esc((meta.priority||[]).join("\n"))}</textarea></label></div><div class="ops-form-section"><h3>例外対応</h3><label>現場判断で調整可能<textarea id="opsManualAdjustable">${esc((meta.adjustable||[]).join("\n"))}</textarea></label><label>店主確認後に変更可能<textarea id="opsManualOwnerApproval">${esc((meta.ownerApproval||[]).join("\n"))}</textarea></label><label>変更不可<textarea id="opsManualForbidden">${esc((meta.forbidden||[]).join("\n"))}</textarea></label></div><div class="ops-form-section"><h3>関連マニュアル（最大3件）</h3><div class="ops-grid-3">${related}</div></div><div class="ops-form-section"><label>最終確認日<input class="form-input" id="opsManualReviewedAt" type="date" value="${esc(meta.lastReviewedAt?meta.lastReviewedAt.slice(0,10):"")}"></label><button class="secondary" id="opsManualTodayBtn">本日、現行基準として確認</button></div>`;
    id("opsManualTodayBtn").addEventListener("click",()=>{id("opsManualReviewedAt").value=todayKey();});
    openModal("opsManualModal");
  }

  function manualMetaFromForm(){
    return {sceneTags:[...id("opsManualSceneTags").querySelectorAll('input:checked')].map((input)=>input.value),ownerLevel:Number(id("opsManualOwnerLevel").value),adjustable:toLines(id("opsManualAdjustable").value).slice(0,20),ownerApproval:toLines(id("opsManualOwnerApproval").value).slice(0,20),forbidden:toLines(id("opsManualForbidden").value).slice(0,20),reason:id("opsManualReason").value.trim(),priority:toLines(id("opsManualPriority").value).slice(0,5),relatedIds:[...id("opsManualForm").querySelectorAll("[data-related-index]")].map((select)=>select.value).filter(Boolean).slice(0,3),reviewMonths:Number(id("opsManualReviewMonths").value),lastReviewedAt:id("opsManualReviewedAt").value?`${id("opsManualReviewedAt").value}T00:00:00.000Z`:"",updatedAt:""};
  }

  async function saveManualFromForm(){
    try{ownerState.manualMeta[editingSceneId]=manualMetaFromForm();await ownerSave({action:"saveManualMeta",manualMeta:ownerState.manualMeta},"正本の運用基準を保存しました");staffState.manualMeta=ownerState.manualMeta;closeModal("opsManualModal");renderOwnerPanel();renderSceneTagSearch();}catch(error){showToast(error.message||"保存できませんでした");}
  }
  async function markManualReviewed(sceneId){
    const meta={...defaultManualMeta(),...(ownerState.manualMeta?.[sceneId]||{})};meta.lastReviewedAt=new Date().toISOString();ownerState.manualMeta[sceneId]=meta;
    try{await ownerSave({action:"saveManualMeta",manualMeta:ownerState.manualMeta});renderOwnerPanel();showToast("現行基準として確認しました");}catch(error){showToast(error.message||"確認日を保存できませんでした");}
  }

  function appendManualMeta(sceneId){
    const body=id("detailBody"),meta=staffState.manualMeta?.[sceneId];if(!body||!meta||id("opsManualMetaDetail"))return;
    const scene=config.scenes.find((item)=>item.id===sceneId);
    const related=(meta.relatedIds||[]).map((relatedId)=>config.scenes.find((item)=>item.id===relatedId)).filter(Boolean);
    const level=Number(meta.ownerLevel||0);
    const html=`<div class="ops-manual-meta" id="opsManualMetaDetail">${(meta.sceneTags||[]).length?`<div class="ops-meta">${meta.sceneTags.map((tag)=>`<span class="badge">${esc(tag)}</span>`).join("")}</div>`:""}<div class="card ${level>=3?'ops-danger':level>=2?'ops-important':''}"><strong>店主確認レベル ${level}</strong><p class="small no-bottom">${esc(OWNER_LEVELS[level]||OWNER_LEVELS[0])}</p></div>${meta.reason?`<div class="ops-manual-block"><h3>基準の理由</h3><p class="preline">${esc(meta.reason)}</p></div>`:""}${(meta.priority||[]).length?`<div class="ops-manual-block"><h3>優先順位</h3><ol class="steps">${meta.priority.map((item)=>`<li>${esc(item)}</li>`).join("")}</ol></div>`:""}${(meta.adjustable||[]).length||(meta.ownerApproval||[]).length||(meta.forbidden||[]).length?`<div class="ops-manual-block"><h3>例外対応</h3>${(meta.adjustable||[]).length?`<strong>現場判断で調整可能</strong><ul class="steps">${meta.adjustable.map((item)=>`<li>${esc(item)}</li>`).join("")}</ul>`:""}${(meta.ownerApproval||[]).length?`<strong>店主確認後に変更可能</strong><ul class="steps">${meta.ownerApproval.map((item)=>`<li>${esc(item)}</li>`).join("")}</ul>`:""}${(meta.forbidden||[]).length?`<strong>変更不可</strong><ul class="steps">${meta.forbidden.map((item)=>`<li>${esc(item)}</li>`).join("")}</ul>`:""}</div>`:""}${related.length?`<div class="ops-manual-block"><h3>関連マニュアル</h3><div class="ops-related-buttons">${related.map((item)=>`<button class="secondary" onclick="openItem('scene','${esc(item.id)}')">${esc(item.title)} ›</button>`).join("")}</div></div>`:""}${scene&&meta.lastReviewedAt?`<div class="small muted">現行基準確認：${esc(meta.lastReviewedAt.slice(0,10))}</div>`:""}</div>`;
    body.insertAdjacentHTML("beforeend",html);
  }

  function renderOwnerUpdates(body){
    const updates=ownerState.updates||[];
    body.innerHTML=`<div class="ops-owner-status"><div><strong>${updates.filter((item)=>item.active).length}</strong><span>公開中</span></div><div><strong>${updates.reduce((sum,item)=>sum+(item.acknowledgements||[]).length,0)}</strong><span>確認記録</span></div><div><strong>${updates.filter((item)=>item.scope==="全員").length}</strong><span>全員対象</span></div><div><strong>${updates.length}</strong><span>登録総数</span></div></div><div class="ops-owner-toolbar"><button class="primary" id="addImportantUpdateBtn">＋重要改訂を登録</button></div><div class="ops-owner-list">${updates.length?updates.map((item)=>`<div class="ops-owner-item ${item.active?'ops-important':''}"><div class="ops-owner-item-top"><div><strong>${esc(item.title)}</strong><div class="small muted">${esc(item.scope)}｜${item.active?'公開中':'非公開'}｜確認 ${(item.acknowledgements||[]).length}件</div></div><span class="badge ${item.active?'warn':''}">${item.active?'確認必須':'非公開'}</span></div><p class="small preline">${esc(item.body)}</p>${(item.acknowledgements||[]).length?`<div class="small muted">${item.acknowledgements.map((ack)=>`${esc(ack.name)} ${formatDateTime(ack.at)}`).join("｜")}</div>`:""}<div class="ops-owner-item-actions"><button class="secondary" data-edit-update="${esc(item.id)}">編集</button></div></div>`).join(""):'<div class="empty">重要改訂は登録されていません。</div>'}</div>`;
    id("addImportantUpdateBtn").addEventListener("click",()=>openUpdateForm(null));
    body.querySelectorAll("[data-edit-update]").forEach((button)=>button.addEventListener("click",()=>openUpdateForm(updates.find((item)=>item.id===button.dataset.editUpdate))));
  }

  function emptyUpdate(){return {id:makeId("update"),title:"",body:"",scope:"全員",relatedSceneId:"",active:true,createdAt:"",updatedAt:"",acknowledgements:[]};}
  function openUpdateForm(item){
    const update=deepClone(item||emptyUpdate());editingUpdateId=item?.id||"";id("opsUpdateTitle").textContent=item?"重要改訂を編集":"重要改訂を登録";id("deleteOpsUpdateBtn").classList.toggle("hidden",!item);
    id("opsUpdateForm").innerHTML=`<label>件名<input class="form-input" id="opsUpdateName" maxlength="180" value="${esc(update.title)}" placeholder="例：アレルギー確認手順を更新"></label><label>変更内容<textarea id="opsUpdateBody" maxlength="4000">${esc(update.body)}</textarea></label><div class="ops-grid-2"><label>対象<select class="form-input" id="opsUpdateScope"><option ${update.scope==='全員'?'selected':''}>全員</option><option ${update.scope==='ホール'?'selected':''}>ホール</option><option ${update.scope==='焼き台責任者'?'selected':''}>焼き台責任者</option></select></label><label>関連する正本<select class="form-input" id="opsUpdateScene"><option value="">未設定</option>${activeItems(config.scenes).map((scene)=>`<option value="${esc(scene.id)}" ${update.relatedSceneId===scene.id?'selected':''}>${esc(scene.title)}</option>`).join("")}</select></label></div><label class="ops-checkbox-label"><input id="opsUpdateActive" type="checkbox" ${update.active?'checked':''}>アルバイトの「確認しました」を必須表示</label><div class="ops-past-box">軽微な文章修正には使わず、安全・アレルギー・会計・料理説明・接客手順の重要変更だけを登録します。</div>`;
    openModal("opsUpdateModal");
  }
  function updateFromForm(){const existing=editingUpdateId?ownerState.updates.find((item)=>item.id===editingUpdateId):null;return {id:editingUpdateId||makeId("update"),title:id("opsUpdateName").value.trim(),body:id("opsUpdateBody").value.trim(),scope:id("opsUpdateScope").value,relatedSceneId:id("opsUpdateScene").value,active:id("opsUpdateActive").checked,createdAt:existing?.createdAt||"",updatedAt:existing?.updatedAt||"",acknowledgements:existing?.acknowledgements||[]};}
  async function saveUpdateFromForm(){
    try{const item=updateFromForm();if(!item.title||!item.body)throw new Error("件名と変更内容を入力してください。");ownerState.updates=ownerState.updates.filter((entry)=>entry.id!==item.id);ownerState.updates.unshift(item);await ownerSave({action:"saveUpdates",updates:ownerState.updates},"重要改訂を保存しました");closeModal("opsUpdateModal");renderOwnerPanel();await loadStaffData({quiet:true});}catch(error){showToast(error.message||"保存できませんでした");}
  }
  async function deleteUpdateFromForm(){if(!editingUpdateId||!confirm("この重要改訂を削除しますか。"))return;try{ownerState.updates=ownerState.updates.filter((item)=>item.id!==editingUpdateId);await ownerSave({action:"saveUpdates",updates:ownerState.updates});closeModal("opsUpdateModal");renderOwnerPanel();await loadStaffData({quiet:true});showToast("重要改訂を削除しました");}catch(error){showToast(error.message||"削除できませんでした");}}

  function renderOwnerSettings(body){
    const s={...DEFAULT_SETTINGS,...ownerState.settings};
    const currentYear=new Date().getFullYear();
    const availableYears=Object.keys(ownerState.reservations||{}).map(Number).filter((year)=>Number.isInteger(year)).sort((a,b)=>b-a);
    const oldYears=availableYears.filter((year)=>year<currentYear-Number(s.retentionYears||5)+1);
