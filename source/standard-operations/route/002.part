        years.map(async (year) => [year, (await readOperationsReservations(year)).map((item) => reservationSchema.parse(item))] as const)
      );
      return NextResponse.json(
        {
          settings,
          reservations: Object.fromEntries(reservationsByYear),
          inventory,
          manualMeta,
          updates,
          sceneTags: SCENE_TAGS,
          seats: SEATS,
          bookingStatuses: BOOKING_STATUSES,
          bookingChannels: BOOKING_CHANNELS,
          prepStatuses: PREP_STATUSES,
        },
        { headers: { "Cache-Control": "no-store" } }
      );
    }

    const staffId = staffIdSchema.parse(url.searchParams.get("staffId") || "");
    const token = tokenSchema.parse(url.searchParams.get("token") || "");
    const staffProfile = await verifyStaff(staffId, token);
    const staffRole = String(staffProfile.role ?? "");
    const requestedDate = dateText.parse(url.searchParams.get("date") || now.toISOString().slice(0, 10));
    const reservations = (await readOperationsReservations(dateYear(requestedDate)))
      .map((item) => reservationSchema.parse(item))
      .filter((item) => item.date === requestedDate && !["キャンセル", "無断キャンセル", "日時変更"].includes(item.bookingStatus))
      .sort((a, b) => a.time.localeCompare(b.time))
      .map((item) => sanitizeReservation(item));
    const staffInventory = inventory.map((item) => ({
      id: item.id,
      category: item.category,
      name: item.name,
      unit: item.unit,
      currentCount: item.currentCount,
      status: item.status,
      urgency: item.urgency,
      supplier: item.supplier,
      orderMethod: item.orderMethod,
      contact: item.contact,
      orderNote: item.orderNote,
      orderDeadline: item.orderDeadline,
      leadDays: item.leadDays,
      useDate: item.useDate,
      orderUnit: item.orderUnit,
      arrivalReportedCount: item.arrivalReportedCount,
    }));
    const alerts = staffInventory.filter((item) => item.status !== "足りる" && item.status !== "入荷完了");
    const activeUpdates = updates
      .filter((item) => item.active)
      .filter((item) => item.scope === "全員" || item.scope === staffRole || (item.scope === "ホール" && staffRole === "研修中") || (item.scope === "焼き台責任者" && staffRole === "厨房"))
      .map((item) => ({
      id: item.id,
      title: item.title,
      body: item.body,
      scope: item.scope,
      relatedSceneId: item.relatedSceneId,
      createdAt: item.createdAt,
      acknowledgements: item.acknowledgements.map((ack) => ({ staffId: ack.staffId })),
    }));

    return NextResponse.json(
      { date: requestedDate, settings, reservations, inventory: staffInventory, inventoryAlerts: alerts, manualMeta, updates: activeUpdates, sceneTags: SCENE_TAGS },
      { headers: { "Cache-Control": "no-store" } }
    );
  } catch (error) {
    if (error instanceof Error && error.message === "OWNER_AUTH_REQUIRED") {
      return NextResponse.json({ error: "店主ログインが必要です。" }, { status: 401 });
    }
    return NextResponse.json(
      { error: error instanceof Error ? error.message : "営業データの読み込みに失敗しました。" },
      { status: 400, headers: { "Cache-Control": "no-store" } }
    );
  }
}

export async function POST(request: Request) {
  try {
    await requireStandardOwner();
    const input = ownerSaveSchema.parse(await request.json());
    const now = new Date().toISOString();

    if (input.action === "saveReservations") {
      const currentReservations = (await readOperationsReservations(input.year)).map((item) => reservationSchema.parse(item));
      const currentById = new Map(currentReservations.map((item) => [item.id, item]));
      const reservations = input.reservations.map((item) => {
        const current = currentById.get(item.id) as any;
        const serverIsNewer = Boolean(current?.updatedAt && item.updatedAt && current.updatedAt > item.updatedAt);
        return {
          ...item,
          phone: normalizePhone(item.phone),
          customerKey: item.customerKey,
          cakeChecks: serverIsNewer ? current?.cakeChecks ?? item.cakeChecks : item.cakeChecks,
          bouquetChecks: serverIsNewer ? current?.bouquetChecks ?? item.bouquetChecks : item.bouquetChecks,
          createdAt: current?.createdAt || item.createdAt || now,
          updatedAt: now,
        };
      });
      if (reservations.some((item) => dateYear(item.date) !== input.year)) {
        throw new Error("予約日と保存年が一致していません。");
      }
      const saved = await writeOperationsReservations(input.year, reservations);
      return NextResponse.json({ success: true, ...saved });
    }

    if (input.action === "saveInventory") {
      const currentInventory = (await readOperationsInventory()).map((item) => inventoryItemSchema.parse(item));
      const currentById = new Map(currentInventory.map((item) => [item.id, item]));
      const items = input.items.map((item) => {
        const current = currentById.get(item.id) as any;
        const serverIsNewer = Boolean(current?.updatedAt && item.updatedAt && current.updatedAt > item.updatedAt);
        return {
          ...item,
          currentCount: serverIsNewer ? current?.currentCount ?? item.currentCount : item.currentCount,
          status: serverIsNewer ? current?.status ?? item.status : item.status,
          urgency: serverIsNewer ? current?.urgency ?? item.urgency : item.urgency,
          arrivalReportedCount: serverIsNewer ? current?.arrivalReportedCount ?? item.arrivalReportedCount : item.arrivalReportedCount,
          lastCheckedAt: serverIsNewer ? current?.lastCheckedAt ?? item.lastCheckedAt : item.lastCheckedAt,
          lastCheckedBy: serverIsNewer ? current?.lastCheckedBy ?? item.lastCheckedBy : item.lastCheckedBy,
          updatedAt: now,
        };
      });
      const saved = await writeOperationsInventory(items);
      return NextResponse.json({ success: true, ...saved });
    }

    if (input.action === "saveManualMeta") {
      const manualMeta = Object.fromEntries(
        Object.entries(input.manualMeta).map(([key, value]) => [key, { ...(value as JsonRecord), updatedAt: now }])
      );
      await writeOperationsManualMeta(manualMeta);
      return NextResponse.json({ success: true, manualMeta });
    }

    if (input.action === "saveUpdates") {
      const currentUpdates = (await readOperationsUpdates()).map((item) => importantUpdateSchema.parse(item));
      const currentById = new Map(currentUpdates.map((item) => [item.id, item]));
      const updates = input.updates.map((item) => {
        const current = currentById.get(item.id) as any;
        const acknowledgements = new Map<string, { staffId: string; name: string; at: string }>();
        [...(current?.acknowledgements ?? []), ...item.acknowledgements].forEach((ack) => acknowledgements.set(ack.staffId, ack));
        return {
          ...item,
          acknowledgements: [...acknowledgements.values()],
          createdAt: current?.createdAt || item.createdAt || now,
          updatedAt: now,
        };
      });
      const saved = await writeOperationsUpdates(updates);
      return NextResponse.json({ success: true, ...saved });
    }

    if (input.action === "saveSettings") {
      const settings = { ...input.settings, updatedAt: now };
      await writeOperationsSettings(settings);
      return NextResponse.json({ success: true, settings });
    }

    const deleted = await deleteOperationsReservationsYear(input.year);
    return NextResponse.json({ success: true, deleted });
  } catch (error) {
    if (error instanceof Error && error.message === "OWNER_AUTH_REQUIRED") {
      return NextResponse.json({ error: "店主ログインが必要です。" }, { status: 401 });
    }
    return NextResponse.json(
      { error: error instanceof Error ? error.message : "営業データの保存に失敗しました。" },
      { status: 400 }
    );
  }
}

export async function PATCH(request: Request) {
  try {
    const input = staffPatchSchema.parse(await request.json());
    if (input.website) return NextResponse.json({ success: true });
    const staffProfile = await verifyStaff(input.staffId, input.token);
    const staffName = String(staffProfile.name ?? "").trim() || "スタッフ";
    const now = new Date().toISOString();

    if (input.action === "reservationCheck") {
      const year = dateYear(input.date);
      const reservations = (await readOperationsReservations(year)).map((item) => reservationSchema.parse(item));
      const index = reservations.findIndex((item) => item.id === input.reservationId && item.date === input.date);
      if (index < 0) throw new Error("対象の予約が見つかりません。");
      const reservation = reservations[index];
      const key = input.group === "cake" ? "cakeChecks" : "bouquetChecks";
      const checks = { ...reservation[key] };
      checks[input.field] = { checked: input.checked, by: staffName, at: now };
      reservations[index] = { ...reservation, [key]: checks, updatedAt: now };
      await writeOperationsReservations(year, reservations);
      return NextResponse.json({ success: true, reservation: sanitizeReservation(reservations[index]) });
    }

    if (input.action === "ackUpdate") {
      const updates = (await readOperationsUpdates()).map((item) => importantUpdateSchema.parse(item));
      const index = updates.findIndex((item) => item.id === input.updateId);
      if (index < 0) throw new Error("対象の重要改訂が見つかりません。");
      const acknowledgements = updates[index].acknowledgements.filter((item) => item.staffId !== input.staffId);
      acknowledgements.push({ staffId: input.staffId, name: staffName, at: now });
      updates[index] = { ...updates[index], acknowledgements, updatedAt: now };
      await writeOperationsUpdates(updates);
      return NextResponse.json({ success: true, update: updates[index] });
    }

    const inventory = (await readOperationsInventory()).map((item) => inventoryItemSchema.parse(item));
    const index = inventory.findIndex((item) => item.id === input.inventoryId);
    if (index < 0) throw new Error("対象の在庫項目が見つかりません。");
    const current = inventory[index];
    inventory[index] = {
      ...current,
      currentCount: input.currentCount,
      status: input.needsOrder ? "発注必要" : current.status === "発注必要" ? "足りる" : current.status,
      urgency: input.urgency,
      arrivalReportedCount: input.arrivalReportedCount ?? current.arrivalReportedCount,
      lastCheckedAt: now,
      lastCheckedBy: staffName,
      updatedAt: now,
    };
    await writeOperationsInventory(inventory);
    return NextResponse.json({ success: true, item: inventory[index] });
  } catch (error) {
    return NextResponse.json(
      { error: error instanceof Error ? error.message : "確認内容を保存できませんでした。" },
      { status: 400 }
    );
  }
}
